{
  "name": "entropy-lang",
  "displayName": "Entropy",
  "description": "Entropy 언어 문법 강조 (엔트리 작품으로 컴파일되는 텍스트 언어)",
  "version": "0.3.53",
  "type": "module",
  "publisher": "entropy",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "entropy",
        "aliases": [
          "Entropy",
          "entropy"
        ],
        "extensions": [
          ".etp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "entropy",
        "scopeName": "source.etp",
        "path": "./syntaxes/entropy.tmLanguage.json"
      }
    ]
  },
  "private": true,
  "scripts": {
    "build:grammar": "node build-grammar.ts"
  },
  "devDependencies": {
    "@entropy/core": "workspace:*",
    "@entropy/parser": "workspace:*"
  }
}
