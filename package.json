{
  "name": "entropy-monorepo",
  "version": "0.4.0",
  "description": "Entropy 언어(엔트리 블록 코드로 변환되는 텍스트 언어) 모노레포",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "editors/*"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:bun": "bun test --timeout 60000 ./test",
    "test:deno": "deno test -A --no-check test/",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p packages/player/tsconfig.browser.json && bunx tsc --noEmit -p packages/vm/tsconfig.browser.json && bunx tsc --noEmit -p packages/extension/tsconfig.browser.json",
    "entropy": "bun packages/cli/index.ts",
    "build:grammar": "bun editors/vscode/build-grammar.ts",
    "entropy-vm": "bun packages/vm/src/node/cli.ts",
    "build:extension": "bun packages/extension/build.ts",
    "watch:extension": "bun packages/extension/watch.ts"
  },
  "trustedDependencies": [
    "core-js",
    "esbuild"
  ],
  "devDependencies": {
    "@entrylabs/entry": "^4.0.23",
    "@entropy/compiler": "workspace:*",
    "@entropy/core": "workspace:*",
    "@entropy/decompiler": "workspace:*",
    "@entropy/parser": "workspace:*",
    "@entropy/player": "workspace:*",
    "@entropy/vm": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "entropy": "workspace:*",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "patchedDependencies": {
    "pixi.js@8.22.0": "patches/pixi.js@8.22.0.patch"
  }
}
