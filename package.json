{
  "name": "tess-monorepo",
  "version": "0.3.53",
  "description": "Tess 언어(엔트리 블록 코드로 변환되는 텍스트 언어) 모노레포",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*",
    "editors/*"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p packages/player/tsconfig.browser.json && bunx tsc --noEmit -p packages/tessvm/tsconfig.browser.json && bunx tsc --noEmit -p packages/extension/tsconfig.browser.json",
    "tess": "bun packages/cli/index.ts",
    "build:grammar": "bun editors/vscode/build-grammar.ts",
    "tessvm": "bun packages/tessvm/src/node/cli.ts",
    "build:extension": "bun packages/extension/build.ts",
    "watch:extension": "bun packages/extension/watch.ts"
  },
  "trustedDependencies": [
    "core-js",
    "esbuild"
  ],
  "devDependencies": {
    "@entrylabs/entry": "^4.0.23",
    "@tess/compiler": "workspace:*",
    "@tess/core": "workspace:*",
    "@tess/decompiler": "workspace:*",
    "@tess/parser": "workspace:*",
    "@tess/player": "workspace:*",
    "@tess/vm": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "tess": "workspace:*",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "patchedDependencies": {
    "pixi.js@8.22.0": "patches/pixi.js@8.22.0.patch"
  }
}
